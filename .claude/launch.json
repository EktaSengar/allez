{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "paris",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve.mjs"
      ],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "app",
      "port": 8081
    }
  ]
}
