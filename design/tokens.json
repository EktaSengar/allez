{
  "$comment": "Locked 13 Oct 2026. Source of truth for Allez colour, type and motion; must agree with DESIGN.md.",
  "brand": {
    "charcoal": {
      "value": "#2C3E50",
      "use": "circle and signature; primary brand colour"
