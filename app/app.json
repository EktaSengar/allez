{
  "expo": {
    "name": "Allez",
    "slug": "allez",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "city.allez.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2C3E50",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "city.allez.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "allez",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allez uses your location to suggest what is worth going to near you. It stays on your phone."
        }
      ],
      "expo-router",
      "expo-sharing",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2C3E50"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allez uses your photos only to put one on a postcard you make. It stays on your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FBF8F3",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#191715"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
